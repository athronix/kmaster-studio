{
  "name": "kmaster-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bridge:dev": "python src/services/hermes/bridge/kmaster_bridge.py"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.0.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.4.0",
    "better-sqlite3": "^11.8.1",
    "js-yaml": "^4.3.0",
    "koa": "^2.15.3",
    "koa-static": "^5.0.0",
    "node-pty": "^1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "proper-lockfile": "^4.1.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.5",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.0"
